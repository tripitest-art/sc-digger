TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: OAuth-Token deines SoundCloud-Accounts. Ohne Token werden native Downloads
# nur verlinkt, weil SoundCloud Original-Dateien nur eingeloggt herausgibt.
SOUNDCLOUD_AUTH_TOKEN=
# Passwort für die lesende Web-Statusseite. Leer = kein Webserver (Standard).
SC_DIGGER_WEB_PASSWORD=
# Pfad zur lokalen Override-Datei (Konfigeditor unter /config). Im Container wird er bei
# gesetztem SC_DIGGER_WEB_PASSWORD automatisch gesetzt; hier nichts tun. Nur für einen
# abweichenden Pfad eintragen; ein leerer Wert schaltet den Editor ab.
SC_DIGGER_CONFIG_LOCAL=
