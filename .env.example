TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: OAuth-Token deines SoundCloud-Accounts. Ohne Token werden native Downloads
# nur verlinkt, weil SoundCloud Original-Dateien nur eingeloggt herausgibt.
SOUNDCLOUD_AUTH_TOKEN=
# Passwort für die lesende Web-Statusseite. Leer = kein Webserver (Standard).
SC_DIGGER_WEB_PASSWORD=
# Pfad zur lokalen Override-Datei. Nur wenn gesetzt, bekommt die Weboberfläche den
# Konfigeditor unter /config; er schreibt ausschließlich in diese Datei (config.yaml bleibt
# unberührt). Ohne Wert bleibt der Editor aus (Standard). Im Container z. B.:
# SC_DIGGER_CONFIG_LOCAL=/data/config.local.yaml
SC_DIGGER_CONFIG_LOCAL=
